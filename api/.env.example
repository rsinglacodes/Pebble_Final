# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=Pebble
API_PREFIX=/api/v1
DEBUG=true

# Database Configuration (Neon PostgreSQL with psycopg 3)
DATABASE_URL=postgresql+psycopg://neondb_owner:npg_sample@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Dedicated Neon test branch for integration tests (never points to main data)
TEST_DATABASE_URL=postgresql+psycopg://neondb_owner:npg_sample_test@ep-sample-test.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_SECRET=dev-jwt-secret-key-change-in-production-min-32-chars

# CORS (Allowed origins as JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Video Service Configuration
VIDEO_PROVIDER=mock
VIDEO_ENGINE_URL=http://localhost:8001
VIDEO_ENGINE_API_KEY=dev-video-engine-api-key-secret
